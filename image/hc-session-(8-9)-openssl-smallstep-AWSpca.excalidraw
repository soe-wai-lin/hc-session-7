    {
      "id": "HSP24vkU1OUvpv7400Bu_",
      "type": "text",
      "x": -586.4210452698051,
      "y": 3075.633988752536,
      "width": 1653.574462890625,
      "height": 150,
      "strokeColor": "#1e1e1e",
