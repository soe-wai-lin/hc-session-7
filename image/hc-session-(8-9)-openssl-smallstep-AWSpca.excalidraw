      "fontSize": 24,
      "fontFamily": 5,
      "text": "Same architecture (dashboard ALB public, counting ALB internal, Route 53 private zone).\nDifference: AWS creates and holds the CA, ACM issues the certs. No step CLI, no key files.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Same architecture (dashboard ALB public, counting ALB internal, Route 53 private zone).\nDifference: AWS creates and holds the CA, ACM issues the certs. No step CLI, no key files.",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "nI9tMLh1ge4fjbn5Pp8gv",
      "type": "text",
      "x": 3074.5627049356044,
      "y": 20.1738140713112,
      "width": 71.05799999999999,
      "height": 29.9,
      "strokeColor": "#7048e8",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roundness": null,
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "seed": 944744458,
      "version": 59,
