      "updated": 1789539526578,
      "link": null,
      "locked": false,
      "fontSize": 27.046175438596453,
      "fontFamily": 8,
      "text": "# dashboard\nopenssl genrsa -out dashboard.key 2048                                                              =================================>\n\nopenssl req -new -sha256 -key dashboard.key -subj \"/CN=dashboard.swl.io\" -out dashboard.csr  =================================>\n\ncat > dashboard.ext <<'EOF'\nbasicConstraints=CA:FALSE\nkeyUsage=digitalSignature,keyEncipherment\nextendedKeyUsage=serverAuth\nsubjectAltName=DNS:dashboard.swl.io\nEOF\n\nopenssl x509 -req -sha256 -days 365 -in dashboard.csr \\                                             =================================> \n  -CA intermediate_ca.crt -CAkey intermediate_ca.key -CAcreateserial \\\n  -extfile dashboard.ext -out dashboard.crt\n\n\n\n",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# dashboard\nopenssl genrsa -out dashboard.key 2048                                                              =================================>\n\nopenssl req -new -sha256 -key dashboard.key -subj \"/CN=dashboard.swl.io\" -out dashboard.csr  =================================>\n\ncat > dashboard.ext <<'EOF'\nbasicConstraints=CA:FALSE\nkeyUsage=digitalSignature,keyEncipherment\nextendedKeyUsage=serverAuth\nsubjectAltName=DNS:dashboard.swl.io\nEOF\n\nopenssl x509 -req -sha256 -days 365 -in dashboard.csr \\                                             =================================> \n  -CA intermediate_ca.crt -CAkey intermediate_ca.key -CAcreateserial \\\n  -extfile dashboard.ext -out dashboard.crt\n\n\n\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
