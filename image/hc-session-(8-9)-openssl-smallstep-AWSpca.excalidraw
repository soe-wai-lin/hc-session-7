    },
    {
      "id": "TcwmwI48zlCr7XGc4CI4I",
      "type": "text",
      "x": 1720,
      "y": 7440,
      "width": 609.339599609375,
      "height": 100,
      "strokeColor": "#7048e8",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roundness": null,
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "seed": 399798219,
      "version": 5,
      "versionNonce": 1198273503,
      "index": "b0S68",
      "isDeleted": false,
      "groupIds": [],
      "frameId": null,
      "boundElements": [],
      "updated": 1789532412290,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 5,
      "text": "intermediate_ca.key  ->  stays on jumphost, signs all leafs\nintermediate_ca.crt  ->  goes into chain.pem\n\nchain.pem = intermediate_ca.crt + root_ca.crt  ->  ACM \"chain\"",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "intermediate_ca.key  ->  stays on jumphost, signs all leafs\nintermediate_ca.crt  ->  goes into chain.pem\n\nchain.pem = intermediate_ca.crt + root_ca.crt  ->  ACM \"chain\"",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "ThVsraEmhGxhJR1ian-7F",
      "type": "text",
      "x": -648.166666666667,
      "y": 7827.666666666669,
      "width": 1047.204833984375,
      "height": 630,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roundness": null,
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "seed": 1962171173,
      "version": 333,
      "versionNonce": 1935910385,
      "index": "b0S6G",
      "isDeleted": false,
      "groupIds": [],
      "frameId": null,
      "boundElements": [
        {
          "id": "XyYF7g5pYCjUdDiGVBmRj",
