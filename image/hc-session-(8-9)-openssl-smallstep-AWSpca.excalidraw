      "fontSize": 20,
      "fontFamily": 8,
      "text": "openssl genrsa -out root_ca.key 4096\n\nopenssl req -x509 -new -sha256 -days 3650 -key root_ca.key \\\n  -subj \"/C=SG/O=swl/CN=swl.io Root CA\" \\\n  -addext \"basicConstraints=critical,CA:TRUE\" \\\n  -addext \"keyUsage=critical,keyCertSign,cRLSign\" \\\n  -out root_ca.crt",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "openssl genrsa -out root_ca.key 4096\n\nopenssl req -x509 -new -sha256 -days 3650 -key root_ca.key \\\n  -subj \"/C=SG/O=swl/CN=swl.io Root CA\" \\\n  -addext \"basicConstraints=critical,CA:TRUE\" \\\n  -addext \"keyUsage=critical,keyCertSign,cRLSign\" \\\n  -out root_ca.crt",
