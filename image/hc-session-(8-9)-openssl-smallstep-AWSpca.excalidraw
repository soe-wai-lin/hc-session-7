    {
      "id": "WQYNNmzEBZfsQVNpKhqK6",
      "type": "text",
      "x": -660.1318788201094,
      "y": 8835.203124999998,
      "width": 2010.496855703552,
      "height": 642.3466666666658,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roundness": null,
