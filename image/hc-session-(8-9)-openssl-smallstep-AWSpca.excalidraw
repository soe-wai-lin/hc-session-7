      "locked": false,
      "fontSize": 22,
      "fontFamily": 8,
      "text": "step certificate create \"hellocloud.io Intermediate CA\" intermediate_ca.crt intermediate_ca.key \\\n  --profile intermediate-ca --ca root_ca.crt --ca-key root_ca.key --not-after 43800h --no-password --insecure\n\n# from now on ONLY the intermediate signs certs. root_ca.key is not needed any more -> move it away / keep offline",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "step certificate create \"hellocloud.io Intermediate CA\" intermediate_ca.crt intermediate_ca.key \\\n  --profile intermediate-ca --ca root_ca.crt --ca-key root_ca.key --not-after 43800h --no-password --insecure\n\n# from now on ONLY the intermediate signs certs. root_ca.key is not needed any more -> move it away / keep offline",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
