      "fontSize": 22,
      "fontFamily": 8,
      "text": "step certificate create dashboard.hellocloud.io dashboard.crt dashboard.key \\\n  --profile leaf --ca intermediate_ca.crt --ca-key intermediate_ca.key --not-after 8760h --no-password --insecure\n\nstep certificate create counting.hellocloud.io counting.crt counting.key \\\n  --profile leaf --ca intermediate_ca.crt --ca-key intermediate_ca.key --not-after 8760h --no-password --insecure",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "step certificate create dashboard.hellocloud.io dashboard.crt dashboard.key \\\n  --profile leaf --ca intermediate_ca.crt --ca-key intermediate_ca.key --not-after 8760h --no-password --insecure\n\nstep certificate create counting.hellocloud.io counting.crt counting.key \\\n  --profile leaf --ca intermediate_ca.crt --ca-key intermediate_ca.key --not-after 8760h --no-password --insecure",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
