    {
      "id": "d0jDFNvXG7_ueSNVzgJSw",
      "type": "text",
      "x": -691.6666666666665,
      "y": 9866.833333333332,
      "width": 1894.208251953125,
      "height": 210,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roundness": null,
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "seed": 1490654693,
      "version": 158,
      "versionNonce": 319274129,
      "index": "b0S9",
      "isDeleted": false,
      "groupIds": [],
      "frameId": null,
      "boundElements": [],
      "updated": 1789533937495,
      "link": null,
      "locked": false,
      "fontSize": 28,
      "fontFamily": 8,
      "text": "cat intermediate_ca.crt root_ca.crt > chain.pem            # intermediate first, then root\n\nopenssl verify -CAfile root_ca.crt -untrusted intermediate_ca.crt dashboard.crt    # -> dashboard.crt: OK\nopenssl verify -CAfile root_ca.crt -untrusted intermediate_ca.crt counting.crt     # -> counting.crt: OK\nopenssl x509 -in dashboard.crt -noout -subject -issuer -dates\nopenssl x509 -in dashboard.crt -noout -text | grep -A1 \"Subject Alternative Name\"   # must show DNS:dashboard.hellocloud.io",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "cat intermediate_ca.crt root_ca.crt > chain.pem            # intermediate first, then root\n\nopenssl verify -CAfile root_ca.crt -untrusted intermediate_ca.crt dashboard.crt    # -> dashboard.crt: OK\nopenssl verify -CAfile root_ca.crt -untrusted intermediate_ca.crt counting.crt     # -> counting.crt: OK\nopenssl x509 -in dashboard.crt -noout -subject -issuer -dates\nopenssl x509 -in dashboard.crt -noout -text | grep -A1 \"Subject Alternative Name\"   # must show DNS:dashboard.hellocloud.io",
