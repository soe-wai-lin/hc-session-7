      "updated": 1789532412290,
      "link": null,
      "locked": false,
      "fontSize": 22,
      "fontFamily": 8,
      "text": "# step ca certificate writes leaf cert + key separately; make sure you also have the chain\nls  dashboard.crt dashboard.key  counting.crt counting.key  /etc/step-ca/certs/root_ca.crt /etc/step-ca/certs/intermediate_ca.crt\n\n# if a .crt file is a bundle (leaf + intermediate together) ACM needs them split:\ncsplit -z -f cert-part- dashboard.crt '/-----BEGIN CERTIFICATE-----/' '{*}'\n#   cert-part-00 = leaf (Certificate body)      cert-part-01.. = intermediate/root (Certificate chain)\n\n# chain to give ACM = intermediate_ca.crt + root_ca.crt\ncat /etc/step-ca/certs/intermediate_ca.crt /etc/step-ca/certs/root_ca.crt > chain.pem\n\n# key must be unencrypted PEM (step ca certificate with --no-password --insecure, or:)\nstep crypto key format dashboard.key --no-password --insecure > dashboard-plain.key",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# step ca certificate writes leaf cert + key separately; make sure you also have the chain\nls  dashboard.crt dashboard.key  counting.crt counting.key  /etc/step-ca/certs/root_ca.crt /etc/step-ca/certs/intermediate_ca.crt\n\n# if a .crt file is a bundle (leaf + intermediate together) ACM needs them split:\ncsplit -z -f cert-part- dashboard.crt '/-----BEGIN CERTIFICATE-----/' '{*}'\n#   cert-part-00 = leaf (Certificate body)      cert-part-01.. = intermediate/root (Certificate chain)\n\n# chain to give ACM = intermediate_ca.crt + root_ca.crt\ncat /etc/step-ca/certs/intermediate_ca.crt /etc/step-ca/certs/root_ca.crt > chain.pem\n\n# key must be unencrypted PEM (step ca certificate with --no-password --insecure, or:)\nstep crypto key format dashboard.key --no-password --insecure > dashboard-plain.key",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
