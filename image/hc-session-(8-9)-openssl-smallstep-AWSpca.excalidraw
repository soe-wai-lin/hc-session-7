      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "aHoQ1--XrVgaDBieT9qZs",
      "type": "text",
      "x": -120,
      "y": 2035.2024068604587,
      "width": 275.10800000000006,
      "height": 50,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
