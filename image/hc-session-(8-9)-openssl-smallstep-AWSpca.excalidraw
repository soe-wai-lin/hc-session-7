    {
      "id": "jfRnQZqL5Lw4ONFtupvdO",
      "type": "text",
      "x": -689.1666666666666,
      "y": 10174.833333333334,
      "width": 1647.807373046875,
      "height": 280,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roundness": null,
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "seed": 1331138885,
      "version": 102,
      "versionNonce": 2049574993,
      "index": "b0S9t",
      "isDeleted": false,
      "groupIds": [],
      "frameId": null,
      "boundElements": [],
      "updated": 1789533940300,
      "link": null,
      "locked": false,
      "fontSize": 28,
      "fontFamily": 8,
      "text": "root_ca.crt          ->  laptop browser trust store, dashboard EC2 trust store   (only the ROOT is trusted)\nroot_ca.key          ->  offline / secret\nintermediate_ca.crt  ->  part of chain.pem\nintermediate_ca.key  ->  stays on jumphost (secret), signs new leaf certs\nchain.pem            ->  ACM \"Certificate chain\" field   (intermediate + root)\ndashboard.crt/key    ->  ACM import  ->  dashboard ALB 443 listener\ncounting.crt/key     ->  ACM import  ->  counting ALB 443 listener\n*.csr, *.ext, *.srl  ->  scratch files, can delete",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "root_ca.crt          ->  laptop browser trust store, dashboard EC2 trust store   (only the ROOT is trusted)\nroot_ca.key          ->  offline / secret\nintermediate_ca.crt  ->  part of chain.pem\nintermediate_ca.key  ->  stays on jumphost (secret), signs new leaf certs\nchain.pem            ->  ACM \"Certificate chain\" field   (intermediate + root)\ndashboard.crt/key    ->  ACM import  ->  dashboard ALB 443 listener\ncounting.crt/key     ->  ACM import  ->  counting ALB 443 listener\n*.csr, *.ext, *.srl  ->  scratch files, can delete",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
