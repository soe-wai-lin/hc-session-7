      "fontSize": 22,
      "fontFamily": 8,
      "text": "# Amazon Linux / RHEL\nsudo cp root_ca.crt /etc/pki/ca-trust/source/anchors/hellocloud-root-ca.pem\nsudo update-ca-trust extract\n# Debian / Ubuntu\nsudo cp root_ca.crt /usr/local/share/ca-certificates/hellocloud-root-ca.crt && sudo update-ca-certificates\n# or with step:  sudo step certificate install root_ca.crt\n\n# upstream env\nCOUNTING_UPSTREAM_URL=https://counting.hellocloud.io\nsudo systemctl restart dashboard-service && sudo systemctl status dashboard-service --no-pager\ncurl -v https://counting.hellocloud.io/health          # must show: SSL certificate verify ok",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# Amazon Linux / RHEL\nsudo cp root_ca.crt /etc/pki/ca-trust/source/anchors/hellocloud-root-ca.pem\nsudo update-ca-trust extract\n# Debian / Ubuntu\nsudo cp root_ca.crt /usr/local/share/ca-certificates/hellocloud-root-ca.crt && sudo update-ca-certificates\n# or with step:  sudo step certificate install root_ca.crt\n\n# upstream env\nCOUNTING_UPSTREAM_URL=https://counting.hellocloud.io\nsudo systemctl restart dashboard-service && sudo systemctl status dashboard-service --no-pager\ncurl -v https://counting.hellocloud.io/health          # must show: SSL certificate verify ok",
      "autoResize": true,
