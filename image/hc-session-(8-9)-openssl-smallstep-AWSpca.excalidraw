      "fontSize": 26,
      "fontFamily": 7,
      "text": "Steps",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Steps",
      "autoResize": true,
      "lineHeight": 1.15,
